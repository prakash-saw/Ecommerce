# Server Port
PORT=5000

# Client Domain URL for CORS Whitelisting
CLIENT_URL=http://localhost:5173

# MongoDB URI (MongoDB Atlas or local URI). If left empty, auto-spins in-memory Mongo for zero-config testing.
MONGODB_URI=

# JWT Secret for User and Admin Authentication (Minimum 32 characters in production)
JWT_SECRET=your_production_jwt_secret_min_32_characters_here

# Razorpay Indian Payment Gateway Credentials (Use test keys rzp_test_... for sandbox)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Print-on-Demand Fulfilment Mode: 'manual' (default) or 'automated'
POD_FULFILLMENT_MODE=manual

# Future Automated Provider API Key (e.g. Printrove, Qikink, Gelato)
POD_PROVIDER_API_KEY=

# Atelier WhatsApp Customer Support Number (International format without '+', e.g. 919876543210)
WHATSAPP_SUPPORT_NUMBER=919876543210

# Nodemailer SMTP Configuration for Email OTP & Notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=BLANC ATELIER
SMTP_FROM_EMAIL=support@blancatelier.com

# OTP Security Parameters
OTP_EXPIRY_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

